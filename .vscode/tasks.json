{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: Compile Tests",
            "type": "shell",
            "command": "mvn",
            "args": ["test-compile"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$maven"
        },
        {
            "label": "Maven: Run TestNG Suite",
            "type": "shell",
            "command": "mvn",
            "args": ["test"],
            "group": "test",
            "problemMatcher": "$maven"
        },
        {
            "label": "Maven: Debug TestNG (Port 5005)",
            "type": "shell",
            "command": "mvn",
            "args": ["test", "-Dmaven.surefire.debug"],
            "group": "test",
            "problemMatcher": "$maven"
        },
        {
            "label": "Maven: Clean",
            "type": "shell",
            "command": "mvn",
            "args": ["clean"],
            "problemMatcher": "$maven"
        }
    ]
}
